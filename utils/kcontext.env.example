# Copy to /etc/kcontext/kcontext.env and adjust.
# Install: sudo install -d -m 0750 /etc/kcontext
#          sudo install -m 0640 kcontext.env.example /etc/kcontext/kcontext.env

# Core
REDIS_ADDR=localhost:6379
LISTEN_ADDR=:8083

# Alertmanager polling (set ALERTMANAGER_URL="" to disable)
ALERTMANAGER_URL=https://localhost:9094
ALERTMANAGER_PORT_FORWARD=auto
ALERTMANAGER_PF_NAMESPACE=openshift-monitoring
ALERTMANAGER_PF_SERVICE=alertmanager-main
ALERTMANAGER_PF_LOCAL_PORT=9094
ALERTMANAGER_PF_REMOTE_PORT=9094
ALERTMANAGER_POLL_INTERVAL=10s
ALERTMANAGER_TLS_INSECURE=true

# OpenShift token (local dev; in-cluster use ALERTMANAGER_TOKEN_FILE instead)
# install-kcontext.sh sets KCONTEXT_DEPLOY_DIR to /opt/kcontext/deploy/openshift
KCONTEXT_NAMESPACE=kcontext
KCONTEXT_SA=kcontext
KCONTEXT_TOKEN_DURATION=8760h
KCONTEXT_DEPLOY_DIR=/opt/kcontext/deploy/openshift

# In-cluster example:
# ALERTMANAGER_URL=https://alertmanager-main.openshift-monitoring.svc:9094
# ALERTMANAGER_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
# ALERTMANAGER_PORT_FORWARD=false

# Optional Slack
# SLACK_TOKEN=
# SLACK_CHANNEL_ID=
